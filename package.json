{
  "name": "portfolio-v3",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run build && npm run test:e2e",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
